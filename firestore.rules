rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    match /hospitals/{hospitalId} {
      allow read, write: if request.auth != null;
    }

    match /emergency_requests/{requestId} {
      allow create: if request.auth != null;
      
      // Temporarily allowing all authenticated users to read emergency requests.
      // This allows the Patient's app to query if an EMT is currently on a trip.
      allow read: if request.auth != null;
         
      allow update: if request.auth != null &&
        (
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('emtUid', '') == request.auth.uid ||
          resource.data.get('assignedEmtUid', '') == request.auth.uid
        );

      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          (
            get(/databases/$(database)/documents/emergency_requests/$(requestId)).data.get('uid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/emergency_requests/$(requestId)).data.get('emtUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/emergency_requests/$(requestId)).data.get('assignedEmtUid', '') == request.auth.uid
          );
      }
    }
  }
}
